{
  "name": "pgpreview",
  "version": "0.0.1",
  "description": "See exactly which rows a Postgres INSERT, UPDATE or DELETE would write, before it runs. Then apply only those rows, and only if none of them have changed.",
  "keywords": [
    "postgres",
    "postgresql",
    "sql",
    "preview",
    "dry-run",
    "diff",
    "approval",
    "agent",
    "safety",
    "mcp"
  ],
  "homepage": "https://github.com/polycore/pgpreview#readme",
  "bugs": "https://github.com/polycore/pgpreview/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polycore/pgpreview.git"
  },
  "license": "MIT",
  "author": "Polycore, Inc. (https://polycore.ai)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "pgsql-parser": "^18.2.6",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public"
  }
}
